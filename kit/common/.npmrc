# Sends the @q-labs scope (the Cobalt design system) to GitHub Packages.
# This file is committed and holds NO token. Your token goes in your
# user-level ~/.npmrc:
#   //npm.pkg.github.com/:_authToken=<a GitHub token with read:packages>
# CI uses the COBALT_PACKAGES_TOKEN secret instead.
@q-labs:registry=https://npm.pkg.github.com
