# Copy to `.env` for local development. Never commit `.env`.
# Every variable the app reads is listed here with a placeholder.
# Standard: https://qiheme.github.io/handbook/#/standards/security

# --- Public values (compiled into the browser bundle) -------------------------
# Anything prefixed VITE_ (or PUBLIC_ in Astro) is public. Never put a secret
# behind one of these prefixes.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# --- Server-only values (full-stack apps and scripts; delete if unused) -------
# Runtime: the Supabase TRANSACTION pooler, port 6543.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=verify-full
# Migrations: the Supabase SESSION pooler, port 5432. Never the 6543 string.
# DIRECT_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full

# --- Not here ------------------------------------------------------------------
# Third-party API keys (model providers, payments) are Supabase Function
# secrets. The service-role key never goes in a file a browser build can read.
